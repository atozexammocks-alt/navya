rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function authd() { return request.auth != null; }
    function verified() { return authd() && request.auth.token.email_verified == true; }
    function superAdmin() { return verified() && request.auth.token.email == 'vikasattri3003@gmail.com'; }
    function me() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function sameOrg(id) { return verified() && (superAdmin() || me().organizationId == id); }
    function manager(id) { return verified() && (superAdmin() || (me().organizationId == id && me().role in ['OWNER','ADMIN','HOD'])); }
    function ownOrgCreate() { return authd() && request.resource.data.ownerId == request.auth.uid && request.resource.data.status == 'ACTIVE'; }
    match /organizations/{id} {
      allow create: if ownOrgCreate();
      allow read: if sameOrg(id);
      allow update: if superAdmin() || (sameOrg(id) && me().role == 'OWNER');
      allow delete: if superAdmin();
    }
    match /users/{uid} {
      allow create: if authd() && (
        (uid == request.auth.uid &&
          exists(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)) &&
          get(/databases/$(database)/documents/organizations/$(request.resource.data.organizationId)).data.ownerId == request.auth.uid)
        || manager(request.resource.data.organizationId)
      );
      allow read: if verified() && (uid == request.auth.uid || superAdmin() || sameOrg(resource.data.organizationId));
      allow update: if verified() && (uid == request.auth.uid || manager(resource.data.organizationId));
      allow delete: if verified() && (superAdmin() || manager(resource.data.organizationId));
    }
    match /auditLogs/{id} {
      allow create: if verified() && (superAdmin() || sameOrg(request.resource.data.organizationId));
      allow read: if verified() && (superAdmin() || sameOrg(resource.data.organizationId));
      allow update, delete: if superAdmin();
    }
    match /{collection}/{id} {
      allow read: if verified() && (
        superAdmin() ||
        (resource.data.organizationId != null && sameOrg(resource.data.organizationId))
      );
      allow create: if verified() && (
        superAdmin() ||
        (request.resource.data.organizationId != null && sameOrg(request.resource.data.organizationId))
      );
      allow update: if verified() && (
        superAdmin() ||
        (resource.data.organizationId != null && sameOrg(resource.data.organizationId))
      );
      allow delete: if verified() && (
        superAdmin() ||
        (resource.data.organizationId != null && manager(resource.data.organizationId))
      );
    }
    match /{document=**} { allow read, write: if false; }
  }
}