rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() { return request.auth != null; }
    function isSuper() { return signedIn() && request.auth.token.email == 'vikasattri3003@gmail.com'; }
    function orgFromPath(orgId) {
      return signedIn() && (isSuper() || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.organizationId == orgId);
    }

    match /organizations/{orgId}/{allPaths=**} {
      allow read: if orgFromPath(orgId);
      allow write: if orgFromPath(orgId) && (isSuper() || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['OWNER','ADMIN','HOD','TEACHER']);
      allow delete: if orgFromPath(orgId) && (isSuper() || firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role in ['OWNER','ADMIN']);
    }

    match /central/{allPaths=**} {
      allow read, write: if isSuper();
    }

    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
